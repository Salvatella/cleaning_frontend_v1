{
  "name": "cleaning-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Dashboard de limpieza y gastos del piso",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js",
    "start": "node server/index.js",
    "test:tricount": "node tools/test-tricount.mjs",
    "sync": "node tools/sync-tricount.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "date-fns": "^4.1.0",
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.7.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "vite": "^7.0.6"
  },
  "engines": {
    "node": ">=20"
  }
}
