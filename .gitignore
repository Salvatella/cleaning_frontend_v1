node_modules/
web/dist/
*.log
.DS_Store

# --- Datos del piso: NO subir al repo -------------------------------------
# db.json lleva dentro el enlace del Tricount, y con ese enlace cualquiera
# puede leer vuestros gastos. db.example.json sí se sube: es la plantilla
# vacía para arrancar de cero.
db.json
db.bak.json
tricount-raw.json

# snapshots/ SÍ se sube: es lo que la web publicada lee para mostrar los meses
# cerrados y los gastos. Ya no lleva el enlace del Tricount dentro (el script
# lo omite a propósito), solo los datos ya resueltos.
#
# OJO: en un repo público, eso significa que vuestros gastos son visibles para
# cualquiera que dé con el repo. Es la misma exposición que tener la web
# pública, porque la web los enseña igual. Si no os vale, el repo debe ser
# privado y la web publicarse en Netlify o Cloudflare Pages.

# --- Credenciales ---------------------------------------------------------
# La publishable de Supabase SÍ va en web/src/config.js (es pública por
# diseño). Lo que nunca se sube es la clave secreta ni la de Postgres.
.env
supabase/config.local.json
